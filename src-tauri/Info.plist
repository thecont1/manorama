<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged over the generated Info.plist by the Tauri bundler.
	     MEGA's CDN estate is mixed: attribute/preview edges
	     (gfs*.userstorage.mega.co.nz) still serve TLS ≤1.2 with non-PFS
	     ciphers, which default ATS rejects with -1200. The SwiftUI shell
	     carries the same exception in scripts/build-macos.sh. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>userstorage.mega.co.nz</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
