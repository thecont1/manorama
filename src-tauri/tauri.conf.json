{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "manorama",
  "version": "0.1.0",
  "identifier": "in.thecontrarian.manorama.desktop",
  "build": {
    "frontendDist": "../desktop/dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "bun run dev:desktop",
    "beforeBuildCommand": "bun run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "manorama",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost data: blob: asset: http://asset.localhost https://manorama.xyz https://*.dropboxapi.com https://*.googleapis.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["in.thecontrarian.manorama.desktop"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.photography",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Developer ID Application: Mahesh Shantaram (373K7W3LKU)",
      "hardenedRuntime": true
    }
  }
}
