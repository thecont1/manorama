{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Malformed or invalid request"
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The referenced gallery or image was not found"
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "No verified Cloudflare Access session"
      },
      "Unavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "A backing store is temporarily unavailable"
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Retention policy refused the operation: GALLERY_LIMIT at the retained-gallery cap (with dashboardUrl), or GALLERY_READ_ONLY on a temporary pipeline gallery"
      },
      "Unprocessable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The request was understood but the operation failed (bad source link, slug collision, ...)"
      },
      "PayloadTooLarge": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The image exceeds the proxy's size ceiling"
      }
    },
    "schemas": {
      "CreateRequest": {
        "additionalProperties": false,
        "properties": {
          "order": {
            "description": "Optional image refs (filenames for Dropbox) in the desired display order; unlisted images keep scan order after them",
            "items": {
              "type": "string"
            },
            "maxItems": 500,
            "type": "array"
          },
          "url": {
            "description": "A public, download-enabled Dropbox folder, Google Drive folder, iCloud shared album, or MEGA folder/collection URL to create the gallery from",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "DeleteResponse": {
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Machine-readable policy refusal code, when the failure is a retention decision",
            "enum": [
              "GALLERY_LIMIT",
              "GALLERY_READ_ONLY"
            ],
            "type": "string"
          },
          "dashboardUrl": {
            "description": "Owner dashboard path to redirect to on GALLERY_LIMIT",
            "type": "string"
          },
          "error": {
            "description": "Human-readable failure reason",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Gallery": {
        "properties": {
          "caption": {
            "type": "string"
          },
          "createdAt": {
            "description": "ISO 8601 timestamp used for recency ordering",
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "imageCount": {
            "minimum": 0,
            "type": "integer"
          },
          "expiresAt": {
            "description": "ISO 8601 removal deadline; set only on pipeline galleries",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array"
          },
          "retention": {
            "description": "retained galleries are editable; pipeline galleries are temporary and read-only until upgrade or expiry",
            "enum": [
              "retained",
              "pipeline"
            ],
            "type": "string"
          },
          "slug": {
            "description": "Stable URL segment identifying the gallery",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "sourceUrl": {
            "description": "Public source URL (Dropbox folder, Google Drive folder, iCloud shared album, or MEGA folder/collection) backing this gallery",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "caption",
          "imageCount",
          "images",
          "retention",
          "expiresAt"
        ],
        "type": "object"
      },
      "GalleryList": {
        "additionalProperties": false,
        "properties": {
          "galleries": {
            "items": {
              "$ref": "#/components/schemas/Gallery"
            },
            "type": "array"
          }
        },
        "required": [
          "galleries"
        ],
        "type": "object"
      },
      "GalleryResponse": {
        "additionalProperties": false,
        "properties": {
          "gallery": {
            "$ref": "#/components/schemas/Gallery"
          },
          "galleryUrl": {
            "description": "Public path of the gallery, returned on create/409 responses",
            "type": "string"
          }
        },
        "required": [
          "gallery"
        ],
        "type": "object"
      },
      "GalleryScan": {
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array"
          },
          "sourceUrl": {
            "description": "Normalized public source URL",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "sourceUrl",
          "title",
          "images"
        ],
        "type": "object"
      },
      "Image": {
        "properties": {
          "alt": {
            "type": "string"
          },
          "c2pa": {
            "description": "Whether the image carries Content Credentials",
            "type": "boolean"
          },
          "caption": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "height": {
            "minimum": 1,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          },
          "ref": {
            "description": "Provider-stable item key used for ordering and refresh dedupe; absent for Dropbox (filename is the key)",
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/ImageVariant"
            },
            "type": "array"
          },
          "width": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "filename",
          "src",
          "width",
          "height",
          "alt",
          "c2pa",
          "placeholder"
        ],
        "type": "object"
      },
      "ImageVariant": {
        "properties": {
          "format": {
            "type": "string"
          },
          "src": {
            "description": "Same-origin URL serving this variant",
            "type": "string"
          },
          "width": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "width",
          "src",
          "format"
        ],
        "type": "object"
      },
      "ScanRequest": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "A public, download-enabled Dropbox folder, Google Drive folder, iCloud shared album, or MEGA folder/collection URL",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "ScanResponse": {
        "additionalProperties": false,
        "properties": {
          "scan": {
            "$ref": "#/components/schemas/GalleryScan"
          }
        },
        "required": [
          "scan"
        ],
        "type": "object"
      },
      "UpdateRequest": {
        "additionalProperties": false,
        "description": "The path slug identifies the gallery; a rename is requested through newSlug only. A body-level replacement slug is not part of the contract.",
        "minProperties": 1,
        "properties": {
          "caption": {
            "maxLength": 500,
            "type": "string"
          },
          "newSlug": {
            "description": "New URL slug for the gallery; changing it changes public URLs and bookmarks",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "order": {
            "description": "New image display order (image refs, or filenames for Dropbox)",
            "items": {
              "type": "string"
            },
            "maxItems": 500,
            "type": "array"
          },
          "title": {
            "description": "New gallery title; cannot be empty when present",
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "cloudflareAccess": {
        "description": "A verified Cloudflare Access JWT, sent as the Cf-Access-Jwt-Assertion header or CF_Authorization cookie. The server verifies issuer, audience, signature, expiry, and the immutable sub claim before authorizing management operations.",
        "in": "header",
        "name": "Cf-Access-Jwt-Assertion",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Gallery management and source image APIs for Manorama, the photography-first publishing application. Management operations require a verified Cloudflare Access session; the image proxies are public because public gallery pages load images through them.",
    "title": "Manorama Gallery Management API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/dropbox/file": {
      "get": {
        "description": "Fetch a full-resolution image from a Dropbox folder by source URL and filename.",
        "operationId": "get_dropbox_file",
        "parameters": [
          {
            "description": "The Dropbox folder source URL",
            "in": "query",
            "name": "sourceUrl",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The image filename",
            "in": "query",
            "name": "filename",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The original image bytes, never recompressed"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [],
        "summary": "Fetch a Dropbox original",
        "tags": [
          "dropbox"
        ]
      }
    },
    "/api/dropbox/thumbnail": {
      "get": {
        "description": "Fetch a thumbnail image from a Dropbox folder by source URL and filename.",
        "operationId": "get_dropbox_thumbnail",
        "parameters": [
          {
            "description": "The Dropbox folder source URL",
            "in": "query",
            "name": "sourceUrl",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The image filename",
            "in": "query",
            "name": "filename",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The thumbnail image bytes"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [],
        "summary": "Fetch a Dropbox thumbnail",
        "tags": [
          "dropbox"
        ]
      }
    },
    "/api/drive/file": {
      "get": {
        "description": "Fetch a full-resolution image from a link-shared Google Drive folder by file ID.",
        "operationId": "get_drive_file",
        "parameters": [
          {
            "description": "The Google Drive file ID",
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The file's resource key, required for resource-keyed shared links",
            "in": "query",
            "name": "rk",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The original image bytes, never recompressed"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [],
        "summary": "Fetch a Google Drive original",
        "tags": [
          "gdrive"
        ]
      }
    },
    "/api/drive/thumbnail": {
      "get": {
        "description": "Fetch a thumbnail image from a link-shared Google Drive folder by file ID. HEIC files are served as JPEG renditions.",
        "operationId": "get_drive_thumbnail",
        "parameters": [
          {
            "description": "The Google Drive file ID",
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Thumbnail width class (w256 default, w2048 for HEIC previews)",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "enum": [
                "w256",
                "w2048"
              ],
              "type": "string"
            }
          },
          {
            "description": "The file's resource key, required for resource-keyed shared links",
            "in": "query",
            "name": "rk",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The thumbnail image bytes"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [],
        "summary": "Fetch a Google Drive thumbnail",
        "tags": [
          "gdrive"
        ]
      }
    },
    "/api/icloud/image": {
      "get": {
        "description": "Fetch an image derivative from a public iCloud shared album. The expiring CDN URL is re-resolved on every request.",
        "operationId": "get_icloud_image",
        "parameters": [
          {
            "description": "The shared album token",
            "in": "query",
            "name": "album",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The photo GUID within the album",
            "in": "query",
            "name": "photo",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The derivative checksum selecting the rendition",
            "in": "query",
            "name": "c",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The derivative image bytes (JPEG, web resolution)"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [],
        "summary": "Fetch an iCloud shared album image",
        "tags": [
          "icloud"
        ]
      }
    },
    "/api/mega/file": {
      "get": {
        "description": "Fetch an original image from a public MEGA shared folder or collection. The AES-128-CTR ciphertext is fetched from MEGA's CDN and decrypted at proxy time using the node key.",
        "operationId": "get_mega_file",
        "parameters": [
          {
            "description": "The public folder handle (either folder or set is required)",
            "in": "query",
            "name": "folder",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The public collection (Set) handle (either folder or set is required)",
            "in": "query",
            "name": "set",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The file node handle within the folder or collection",
            "in": "query",
            "name": "node",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The file's node key (base64url), decrypted at scan time from the share key",
            "in": "query",
            "name": "k",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The decrypted original image bytes"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          }
        },
        "security": [],
        "summary": "Fetch a MEGA image",
        "tags": [
          "mega"
        ]
      }
    },
    "/api/mega/preview": {
      "get": {
        "description": "Fetch MEGA's generated JPEG/WebP preview for an image whose original browsers cannot render (HEIC, TIFF). The encrypted file attribute is fetched through MEGA's ufa endpoint and decrypted at proxy time.",
        "operationId": "get_mega_preview",
        "parameters": [
          {
            "description": "The public folder handle (either folder or set is required)",
            "in": "query",
            "name": "folder",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The public collection (Set) handle (either folder or set is required)",
            "in": "query",
            "name": "set",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The file-attribute handle (base64url) from the node's fa string",
            "in": "query",
            "name": "h",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The file's node key (base64url), decrypted at scan time from the share key",
            "in": "query",
            "name": "k",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/jpeg": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/webp": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The decrypted preview image"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [],
        "summary": "Fetch a MEGA image preview",
        "tags": [
          "mega"
        ]
      }
    },
    "/api/galleries": {
      "get": {
        "description": "List all photo galleries with titles, captions, dates, and image counts.",
        "operationId": "list_galleries",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GalleryList"
                }
              }
            },
            "description": "The gallery list, newest first"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "cloudflareAccess": []
          }
        ],
        "summary": "List galleries",
        "tags": [
          "galleries"
        ]
      },
      "post": {
        "description": "Scan a public Dropbox, Google Drive, or iCloud shared album link and create a gallery from its images, optionally in a given order.",
        "operationId": "create_gallery",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GalleryResponse"
                }
              }
            },
            "description": "The created gallery"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "security": [
          {
            "cloudflareAccess": []
          }
        ],
        "summary": "Create a gallery from a shared link",
        "tags": [
          "galleries"
        ]
      }
    },
    "/api/galleries/scan": {
      "post": {
        "description": "Scan a public Dropbox, Google Drive, or iCloud shared album link to discover images for a new gallery. Returns the source title and image metadata.",
        "operationId": "scan_gallery_source",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            },
            "description": "The scan result"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "security": [
          {
            "cloudflareAccess": []
          }
        ],
        "summary": "Scan a shared link",
        "tags": [
          "galleries"
        ]
      }
    },
    "/api/galleries/{slug}": {
      "delete": {
        "description": "Delete a gallery and its Manorama references. This is irreversible; source files are never touched.",
        "operationId": "delete_gallery",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            },
            "description": "Deletion confirmation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
