{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Malformed or invalid request"
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The referenced gallery or image was not found"
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "No verified Cloudflare Access session"
      },
      "Unavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "A backing store is temporarily unavailable"
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Retention policy refused the operation: GALLERY_LIMIT at the retained-gallery cap (with dashboardUrl), or GALLERY_READ_ONLY on a temporary pipeline gallery"
      },
      "Unprocessable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The request was understood but the operation failed (bad source link, slug collision, ...)"
      },
      "PayloadTooLarge": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The image exceeds the proxy's size ceiling"
      },
      "Conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "A concurrent write won the race — re-read and retry"
      }
    },
    "schemas": {
      "CreateRequest": {
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "manifest"
            ]
          }
        ],
        "properties": {
          "caption": {
            "description": "Optional gallery caption",
            "maxLength": 500,
            "type": "string"
          },
          "manifest": {
            "$ref": "#/components/schemas/EncryptedManifest"
          },
          "order": {
            "description": "Optional image refs (filenames for Dropbox) in the desired display order; unlisted images keep scan order after them",
            "items": {
              "type": "string"
            },
            "maxItems": 1000,
            "type": "array"
          },
          "quick": {
            "description": "Quick-add create: a random three-word title replaces any submitted title",
            "type": "boolean"
          },
          "url": {
            "description": "A public, download-enabled Dropbox folder, Google Drive folder, or iCloud shared album URL to create the gallery from. MEGA and other encrypted sources are created from a client-scanned manifest instead — the server never scans them",
            "type": "string"
          },
          "title": {
            "description": "Optional gallery title; blank falls back to the provider folder name",
            "maxLength": 120,
            "type": "string"
          }
        },
        "type": "object"
      },
      "DeleteResponse": {
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "Fidelity": {
        "description": "Evidence label for the media path actually served; not a MAC or C2PA assertion",
        "enum": [
          "display-derivative",
          "full-resolution-render",
          "original",
          "unknown"
        ],
        "type": "string"
      },
      "EncryptedManifest": {
        "additionalProperties": false,
        "description": "A keyless manifest produced by a client-side encrypted-source scan (manifest record version 2). The server validates and stores it but never scans the provider itself; every item carries an encrypted media reference rather than a fetchable URL, and keyed source URLs are rejected.",
        "properties": {
          "images": {
            "description": "Item ids and refs are unique within the manifest",
            "items": {
              "$ref": "#/components/schemas/EncryptedManifestImage"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
          },
          "provider": {
            "enum": [
              "ente",
              "mega"
            ],
            "type": "string"
          },
          "sourceUrl": {
            "description": "Canonical keyless source URL — no #fragment, must match the declared provider",
            "maxLength": 2048,
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "type": "string"
          },
          "truncated": {
            "description": "Set when the client scan stopped early under its budget; operations that would silently drop unlisted items refuse truncated manifests",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "provider",
          "sourceUrl",
          "title",
          "images"
        ],
        "type": "object"
      },
      "EncryptedManifestImage": {
        "additionalProperties": false,
        "properties": {
          "alt": {
            "maxLength": 2048,
            "type": "string"
          },
          "c2pa": {
            "type": "boolean"
          },
          "caption": {
            "maxLength": 10000,
            "type": "string"
          },
          "contentVersion": {
            "description": "Opaque provider-change detector",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "exif": {
            "description": "Optional EXIF summary, at most 16KB serialized",
            "type": "object"
          },
          "fidelity": {
            "$ref": "#/components/schemas/Fidelity"
          },
          "filename": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "height": {
            "description": "Declared pixel dimensions; aspect ratio must fall within 10:1 either way",
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          },
          "hidden": {
            "type": "boolean"
          },
          "id": {
            "description": "Provider-prefixed stable item id (mega-* or ente-*)",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "media": {
            "$ref": "#/components/schemas/EncryptedMediaReference"
          },
          "placeholder": {
            "description": "data:image/svg+xml placeholder, no markup characters",
            "maxLength": 4096,
            "type": "string"
          },
          "ref": {
            "description": "Provider node handle; must equal media.nodeId",
            "pattern": "^[0-9A-Za-z_-]{1,256}$",
            "type": "string"
          },
          "src": {
            "const": "",
            "description": "Always empty — the public record never carries a fetchable URL",
            "type": "string"
          },
          "thumbnailFidelity": {
            "$ref": "#/components/schemas/Fidelity"
          },
          "type": {
            "const": "image",
            "description": "Optional when set to image; absent also means image",
            "type": "string"
          },
          "width": {
            "description": "Declared pixel dimensions; aspect ratio must fall within 10:1 either way",
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          },
          "variants": {
            "description": "Up to four encrypted preview references",
            "items": {
              "$ref": "#/components/schemas/EncryptedManifestVariant"
            },
            "maxItems": 4,
            "type": "array"
          }
        },
        "required": [
          "id",
          "ref",
          "filename",
          "src",
          "media",
          "contentVersion",
          "width",
          "height",
          "alt",
          "c2pa",
          "placeholder"
        ],
        "type": "object"
      },
      "EncryptedManifestVariant": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "description": "jpeg, webp, or avif (bare or image/* mime form)",
            "maxLength": 20,
            "type": "string"
          },
          "media": {
            "$ref": "#/components/schemas/EncryptedMediaReference"
          },
          "src": {
            "const": "",
            "type": "string"
          },
          "width": {
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "width",
          "src",
          "format",
          "media"
        ],
        "type": "object"
      },
      "EncryptedMediaReference": {
        "additionalProperties": false,
        "description": "Keyless provider coordinates a client uses to fetch and decrypt the item; the server never resolves it",
        "properties": {
          "kind": {
            "const": "encrypted",
            "type": "string"
          },
          "nodeId": {
            "pattern": "^[0-9A-Za-z_-]{1,256}$",
            "type": "string"
          },
          "previewId": {
            "description": "Required on variant references (the file-attribute handle)",
            "pattern": "^[0-9A-Za-z_-]{1,256}$",
            "type": "string"
          },
          "provider": {
            "enum": [
              "ente",
              "mega"
            ],
            "type": "string"
          },
          "sourceId": {
            "pattern": "^[0-9A-Za-z_-]{1,256}$",
            "type": "string"
          },
          "sourceKind": {
            "enum": [
              "album",
              "collection",
              "folder"
            ],
            "type": "string"
          }
        },
        "required": [
          "kind",
          "provider",
          "sourceKind",
          "sourceId",
          "nodeId"
        ],
        "type": "object"
      },
      "MigrateRequest": {
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "description": "Non-secret install identifier; the stored server key retires only after two distinct device ids have verified the gallery (or optOut is set)",
            "pattern": "^[0-9A-Za-z-]{8,128}$",
            "type": "string"
          },
          "manifest": {
            "$ref": "#/components/schemas/EncryptedManifest"
          },
          "optOut": {
            "description": "Retire the server key in this request instead of waiting for a second device",
            "type": "boolean"
          }
        },
        "required": [
          "manifest",
          "deviceId"
        ],
        "type": "object"
      },
      "MigrateResponse": {
        "additionalProperties": false,
        "properties": {
          "gallery": {
            "$ref": "#/components/schemas/Gallery"
          },
          "keyRetired": {
            "description": "Whether the stored server key was retired by this request or an earlier one",
            "type": "boolean"
          },
          "verifiedDevices": {
            "description": "Distinct device ids that have verified this gallery",
            "type": "integer"
          },
          "warning": {
            "description": "Present when the key retired — the server can no longer recover access",
            "type": "string"
          }
        },
        "required": [
          "gallery",
          "verifiedDevices",
          "keyRetired"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Machine-readable refusal code, when the failure carries one",
            "enum": [
              "CLIENT_SCAN_REQUIRED",
              "GALLERY_LIMIT",
              "GALLERY_READ_ONLY",
              "MANIFEST_TOO_LARGE",
              "PARTIAL_SCAN",
              "PIN_LIMIT",
              "SERVER_DECRYPT_RETIRED"
            ],
            "type": "string"
          },
          "dashboardUrl": {
            "description": "Owner dashboard path to redirect to on GALLERY_LIMIT",
            "type": "string"
          },
          "error": {
            "description": "Human-readable failure reason",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Gallery": {
        "properties": {
          "caption": {
            "type": "string"
          },
          "createdAt": {
            "description": "ISO 8601 timestamp used for recency ordering",
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "imageCount": {
            "minimum": 0,
            "type": "integer"
          },
          "expiresAt": {
            "description": "ISO 8601 removal deadline; set only on pipeline galleries",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array"
          },
          "retention": {
            "description": "retained galleries are editable; pipeline galleries are temporary and read-only until upgrade or expiry",
            "enum": [
              "retained",
              "pipeline"
            ],
            "type": "string"
          },
          "slug": {
            "description": "Stable URL segment identifying the gallery",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "sourceUrl": {
            "description": "Public source URL (Dropbox folder, Google Drive folder, iCloud shared album, or MEGA folder/collection) backing this gallery",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "caption",
          "imageCount",
          "images",
          "retention",
          "expiresAt"
        ],
        "type": "object"
      },
      "GalleryList": {
        "additionalProperties": false,
        "properties": {
          "galleries": {
            "items": {
              "$ref": "#/components/schemas/Gallery"
            },
            "type": "array"
          }
        },
        "required": [
          "galleries"
        ],
        "type": "object"
      },
      "GalleryResponse": {
        "additionalProperties": false,
        "properties": {
          "gallery": {
            "$ref": "#/components/schemas/Gallery"
          },
          "galleryUrl": {
            "description": "Public path of the gallery, returned on create/409 responses",
            "type": "string"
          }
        },
        "required": [
          "gallery"
        ],
        "type": "object"
      },
      "GalleryScan": {
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array"
          },
          "sourceUrl": {
            "description": "Normalized public source URL",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "sourceUrl",
          "title",
          "images"
        ],
        "type": "object"
      },
      "Image": {
        "properties": {
          "alt": {
            "type": "string"
          },
          "c2pa": {
            "description": "Whether the image carries Content Credentials",
            "type": "boolean"
          },
          "caption": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "height": {
            "minimum": 1,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          },
          "ref": {
            "description": "Provider-stable item key used for ordering and refresh dedupe; absent for Dropbox (filename is the key)",
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/ImageVariant"
            },
            "type": "array"
          },
          "width": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "filename",
          "src",
          "width",
          "height",
          "alt",
          "c2pa",
          "placeholder"
        ],
        "type": "object"
      },
      "ImageVariant": {
        "properties": {
          "format": {
            "type": "string"
          },
          "src": {
            "description": "Same-origin URL serving this variant",
            "type": "string"
          },
          "width": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "width",
          "src",
          "format"
        ],
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "description": "Empty body refreshes ordinary galleries server-side. Encrypted galleries cannot be scanned by the server and must resubmit a client-scanned manifest — an encrypted refresh without one answers 400 CLIENT_SCAN_REQUIRED.",
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/EncryptedManifest"
          }
        },
        "type": "object"
      },
      "ScanRequest": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "A public, download-enabled Dropbox folder, Google Drive folder, or iCloud shared album URL. MEGA and other encrypted links answer 422 CLIENT_SCAN_REQUIRED — they are scanned on the client",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "ScanResponse": {
        "additionalProperties": false,
        "properties": {
          "scan": {
            "$ref": "#/components/schemas/GalleryScan"
          }
        },
        "required": [
          "scan"
        ],
        "type": "object"
      },
      "UpdateRequest": {
        "additionalProperties": false,
        "description": "The path slug identifies the gallery; a rename is requested through newSlug only. A body-level replacement slug is not part of the contract.",
        "minProperties": 1,
        "properties": {
          "caption": {
            "maxLength": 500,
            "type": "string"
          },
          "newSlug": {
            "description": "New URL slug for the gallery; changing it changes public URLs and bookmarks",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "order": {
            "description": "New image display order (image refs, or filenames for Dropbox)",
            "items": {
              "type": "string"
            },
            "maxItems": 1000,
            "type": "array"
          },
          "title": {
            "description": "New gallery title; cannot be empty when present",
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "cloudflareAccess": {
        "description": "A verified Cloudflare Access JWT, sent as the Cf-Access-Jwt-Assertion header or CF_Authorization cookie. The server verifies issuer, audience, signature, expiry, and the immutable sub claim before authorizing management operations.",
        "in": "header",
        "name": "Cf-Access-Jwt-Assertion",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Gallery management and source image APIs for Manorama, the photography-first publishing application. Management operations require a verified Cloudflare Access session; the image proxies are public because public gallery pages load images through them.",
    "title": "Manorama Gallery Management API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/dropbox/file": {
      "get": {
        "description": "Fetch a full-resolution image from a Dropbox folder by source URL and filename.",
        "operationId": "get_dropbox_file",
        "parameters": [
          {
            "description": "The Dropbox folder source URL",
            "in": "query",
            "name": "sourceUrl",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The image filename",
            "in": "query",
            "name": "filename",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The original image bytes, never recompressed"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [],
        "summary": "Fetch a Dropbox original",
        "tags": [
          "dropbox"
        ]
      }
    },
    "/api/dropbox/thumbnail": {
      "get": {
        "description": "Fetch a thumbnail image from a Dropbox folder by source URL and filename.",
        "operationId": "get_dropbox_thumbnail",
        "parameters": [
          {
            "description": "The Dropbox folder source URL",
            "in": "query",
            "name": "sourceUrl",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The image filename",
            "in": "query",
            "name": "filename",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The thumbnail image bytes"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [],
        "summary": "Fetch a Dropbox thumbnail",
        "tags": [
          "dropbox"
        ]
      }
    },
    "/api/drive/file": {
      "get": {
        "description": "Fetch a full-resolution image from a link-shared Google Drive folder by file ID.",
        "operationId": "get_drive_file",
        "parameters": [
          {
            "description": "The Google Drive file ID",
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The file's resource key, required for resource-keyed shared links",
            "in": "query",
            "name": "rk",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The original image bytes, never recompressed"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [],
        "summary": "Fetch a Google Drive original",
        "tags": [
          "gdrive"
        ]
      }
    },
    "/api/drive/thumbnail": {
      "get": {
        "description": "Fetch a thumbnail image from a link-shared Google Drive folder by file ID. HEIC files are served as JPEG renditions.",
        "operationId": "get_drive_thumbnail",
        "parameters": [
          {
            "description": "The Google Drive file ID",
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Thumbnail width class (w256 default, w2048 for HEIC previews)",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "enum": [
                "w256",
                "w2048"
              ],
              "type": "string"
            }
          },
          {
            "description": "The file's resource key, required for resource-keyed shared links",
            "in": "query",
            "name": "rk",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The thumbnail image bytes"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [],
        "summary": "Fetch a Google Drive thumbnail",
        "tags": [
          "gdrive"
        ]
      }
    },
    "/api/icloud/image": {
      "get": {
        "description": "Fetch an image derivative from a public iCloud shared album. The expiring CDN URL is re-resolved on every request.",
