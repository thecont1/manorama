{
  "format": "vendo/tools@3",
  "tools": [
    {
      "name": "host_create_gallery",
      "description": "Create a gallery from a Dropbox folder. Scan a public Dropbox folder URL and create a gallery from its images, optionally in a given order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "body": {
            "additionalProperties": false,
            "properties": {
              "order": {
                "description": "Optional image filenames in the desired display order; unlisted images keep scan order after them",
                "items": {
                  "type": "string"
                },
                "maxItems": 500,
                "type": "array"
              },
              "url": {
                "description": "A public, download-enabled Dropbox folder URL to create the gallery from",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          }
        },
        "required": [
          "body"
        ]
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "gallery": {
            "properties": {
              "caption": {
                "type": "string"
              },
              "createdAt": {
                "description": "ISO 8601 timestamp used for recency ordering",
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "imageCount": {
                "minimum": 0,
                "type": "integer"
              },
              "images": {
                "items": {
                  "properties": {
                    "alt": {
                      "type": "string"
                    },
                    "c2pa": {
                      "description": "Whether the image carries Content Credentials",
                      "type": "boolean"
                    },
                    "caption": {
                      "type": "string"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "height": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "id": {
                      "type": "string"
                    },
                    "placeholder": {
                      "type": "string"
                    },
                    "src": {
                      "type": "string"
                    },
                    "variants": {
                      "items": {
                        "properties": {
                          "format": {
                            "type": "string"
                          },
                          "src": {
                            "description": "Same-origin URL serving this variant",
                            "type": "string"
                          },
                          "width": {
                            "minimum": 1,
                            "type": "integer"
                          }
                        },
                        "required": [
                          "width",
                          "src",
                          "format"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "width": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "filename",
                    "src",
                    "width",
                    "height",
                    "alt",
                    "c2pa",
                    "placeholder"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "slug": {
                "description": "Stable URL segment identifying the gallery",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "sourceUrl": {
                "description": "Public Dropbox folder URL backing this gallery",
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "title",
              "caption",
              "imageCount",
              "images"
            ],
            "type": "object"
          }
        },
        "required": [
          "gallery"
        ],
        "type": "object"
      },
      "risk": "ungraded",
      "binding": {
        "kind": "openapi",
        "operationId": "create_gallery",
        "baseUrl": "https://manorama.xyz",
        "method": "POST",
        "path": "/api/galleries"
      },
      "inputSchemaSource": "declared",
      "outputSchemaSource": "declared",
      "srcHash": "sha256:f506a4b7b80e459ddbaaad3647752457dc7b2e010668fd81b2b293637a5a2209"
    },
    {
      "name": "host_delete_gallery",
      "description": "Delete a gallery. Delete a gallery and its Manorama references. This is irreversible; Dropbox files are never touched.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Current gallery URL slug — the resource identity"
          }
        },
        "required": [
          "slug"
        ]
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "risk": "destructive",
      "binding": {
        "kind": "openapi",
        "operationId": "delete_gallery",
        "baseUrl": "https://manorama.xyz",
        "method": "DELETE",
        "path": "/api/galleries/{slug}"
      },
      "inputSchemaSource": "declared",
      "outputSchemaSource": "declared",
      "srcHash": "sha256:f506a4b7b80e459ddbaaad3647752457dc7b2e010668fd81b2b293637a5a2209"
    },
    {
