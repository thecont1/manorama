        "method": "GET",
        "path": "/api/mega/preview"
      },
      "inputSchemaSource": "declared",
      "outputSchemaSource": "unknown",
      "srcHash": "sha256:fc7386f9ad5050eaa03032b79c50e27c99653804207c5c2c2b2e45fe99f0ae54"
    },
