    {
      "name": "host_update_gallery",
      "description": "Update a gallery. Update a gallery's title, caption, image order, or URL slug (rename via newSlug).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Current gallery URL slug — the resource identity"
          },
          "body": {
            "additionalProperties": false,
            "description": "The path slug identifies the gallery; a rename is requested through newSlug only. A body-level replacement slug is not part of the contract.",
            "minProperties": 1,
            "properties": {
              "caption": {
                "maxLength": 500,
                "type": "string"
              },
              "newSlug": {
                "description": "New URL slug for the gallery; changing it changes public URLs and bookmarks",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "order": {
                "description": "New image display order (filenames)",
                "items": {
                  "type": "string"
                },
                "maxItems": 500,
                "type": "array"
              },
              "title": {
                "description": "New gallery title; cannot be empty when present",
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "slug",
          "body"
        ]
