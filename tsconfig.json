{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "app",
    "packages",
    "native",
    "desktop",
    "desktop-shell",
    "security-audit",
    "vite.config.ts",
    "vite.config.native.ts",
    "vite.config.desktop.ts",
    "vite.config.desktop-shell.ts"
  ]
}
