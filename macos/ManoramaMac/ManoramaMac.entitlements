<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for App Store distribution. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>


	<!-- Sign in with Apple is NOT declared here: like keychain-access-groups
	     it is a restricted entitlement, and an unprofiled direct build that
	     declares it is killed at exec. It lives in the App Store file, where
	     the embedded distribution profile authorises it. A profiled
	     development build that wants to exercise the native sheet must embed
	     the profile AND declare the key — both pieces together. -->
	<!-- Outbound: manorama.xyz API, provider APIs/CDNs (Dropbox, Drive, MEGA,
	     Proton), all via URLSession + WKWebView. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Inbound: the OAuth loopback listener on 127.0.0.1 (oauth_loopback_*). -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- User-picked local gallery roots via NSOpenPanel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Persist those picks as security-scoped bookmarks so folder access
	     survives relaunches without re-prompting. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<!-- Shared vault custody: gallery keys and the device id live in the
	     data-protection keychain under this group, so every build signed
	     by the team — Developer ID, App Store, or a re-signed test
	     bundle — reads them without a per-item OS prompt. The name is
	     deliberately not derived from the bundle id: this same file
	     signs test bundles whose CFBundleIdentifier differs. -->
</dict>
</plist>
