<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store distribution signature: the distribution provisioning
	     profile carries an application-identifier, so the signature must
	     embed the same identifiers (Transporter warning 90886). -->
	<key>com.apple.application-identifier</key>
	<string>373K7W3LKU.in.thecontrarian.manorama</string>
	<key>com.apple.developer.team-identifier</key>
	<string>373K7W3LKU</string>

	<!-- Required for App Store distribution. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Outbound: manorama.xyz API, provider APIs/CDNs (Dropbox, Drive, MEGA,
	     Proton), all via URLSession + WKWebView. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Inbound: the OAuth loopback listener on 127.0.0.1 (oauth_loopback_*). -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- User-picked local gallery roots via NSOpenPanel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Persist those picks as security-scoped bookmarks so folder access
	     survives relaunches without re-prompting. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<!-- Shared vault custody: gallery keys and the device id live in the
	     data-protection keychain under this group, so every build signed
	     by the team reads them without a per-item OS prompt. The name is
	     deliberately not derived from the bundle id, so a bundle whose
	     CFBundleIdentifier differs keeps custody. -->
	<key>keychain-access-groups</key>
	<array>
		<string>373K7W3LKU.manorama.shared</string>
	</array>
</dict>
</plist>
