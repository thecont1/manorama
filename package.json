{
  "name": "manorama",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env.local vite --host 0.0.0.0",
    "build": "vite build --mode client && vite build",
    "build:native": "bunx vite build --config vite.config.native.ts",
    "native:assets": "bunx capacitor-assets generate --assetPath assets --iconBackgroundColor '#0a0a0a' --iconBackgroundColorDark '#0a0a0a' --splashBackgroundColor '#0a0a0a' --splashBackgroundColorDark '#0a0a0a' --ios --android",
    "native:sync": "bun run build:native && bunx cap sync",
    "native:open:ios": "bunx cap open ios",
    "native:open:android": "bunx cap open android",
    "preview": "bun --env-file=.env.local vite preview --host 0.0.0.0",
    "test": "playwright test",
    "vendo:sync": "vendo sync --no-ai && bun scripts/gen-vendo-profile.ts",
    "vendo:profile": "bun scripts/gen-vendo-profile.ts",
    "vendo:check": "vendo sync --strict --no-ai && bun scripts/gen-vendo-profile.ts && git diff --exit-code -- .vendo/tools.json vendo/profile.generated.ts",
    "types": "wrangler types",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@contentauth/c2pa-web": "^0.14.3",
    "@revenuecat/purchases-capacitor": "^13.6.0",
    "@revenuecat/purchases-capacitor-ui": "^13.6.0",
    "@vendoai/vendo": "^0.54.2",
    "c2pa-wc": "^0.14.17",
    "heic2any": "^0.0.4",
    "hono": "^4.9.7",
    "honox": "^0.1.61",
    "jimp": "^1.6.1",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.2",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.14.5",
    "sharp": "^0.34.5",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "wrangler": "^4.95.0"
  }
}
