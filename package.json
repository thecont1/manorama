{
  "name": "manorama-italy-2018",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env.local vite --host 0.0.0.0",
    "build": "vite build --mode client && vite build",
    "preview": "bun --env-file=.env.local vite preview --host 0.0.0.0",
    "gallery": "node build-gallery.mjs ./images ./public/images italy-2018",
    "test": "playwright test qa.spec.ts",
    "deploy": "bun run gallery && bun run build && wrangler deploy"
  },
  "dependencies": {
    "@contentauth/c2pa-web": "^0.14.3",
    "@vendoai/vendo": "^0.54.2",
    "c2pa-wc": "^0.14.17",
    "exifr": "^7.1.3",
    "hono": "^4.9.7",
    "honox": "^0.1.61",
    "jose": "^6.2.10",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.55.0",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "wrangler": "^4.95.0"
  }
}
