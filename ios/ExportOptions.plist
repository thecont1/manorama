<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store upload options consumed by `xcodebuild -exportArchive`.
	     signingStyle stays automatic on purpose: the App Store profile the
	     workflow installs is Xcode-managed, and an export that names it under
	     a manual signing style is rejected with "provisioning profile ... is
	     Xcode managed, but signing settings require a manually managed
	     profile". Automatic signing reuses that managed profile together with
	     the Apple Distribution certificate installed before archiving. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>373K7W3LKU</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>