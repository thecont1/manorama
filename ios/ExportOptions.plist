<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store upload options: xcodebuild -exportArchive consumes this so
	     the release pipeline stays reproducible outside Xcode's UI.

	     signingStyle is manual on purpose. With automatic signing the export
	     falls back to an iOS development team profile and fails with
	     "No signing certificate \"iOS Distribution\" found"; the profile named
	     below is the App Store profile installed by .github/workflows/ios.yml. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>373K7W3LKU</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>in.thecontrarian.manorama</key>
		<string>iOS Team Store Provisioning Profile: in.thecontrarian.manorama</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>