<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Same exclusion as backup_rules.xml, covering
     both cloud backup and device-to-device transfer — a moved vault is
     ciphertext without its Keystore keys. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="manorama-vault-v1" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="manorama-vault-v1" />
    </device-transfer>
</data-extraction-rules>
