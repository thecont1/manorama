node_modules/
dist/
.wrangler/
test-results/
playwright-report/
.DS_Store
.env
.env.*
!.env.example
.dev.vars

# Vendo local PGlite store — runtime state, not source
.vendo/data/

# Playwright MCP ephemeral artifacts
.playwright-mcp/
.devin/

# Tauri build artifacts and generated capability schemas
src-tauri/target/
src-tauri/gen/

# Simulator derived data written by scripts/capture-screens.sh
ios/build/

# Per-run simulator ids
.work/udid-*

# Throwaway inspection artifacts from capture and App Store Connect sessions
.work/shots/
.work/snap.json
.work/ax.sh

# Scratch used when $HOME is not writable: bun's package cache and TMPDIR. They
# are caches, not source, and between them they are thousands of files.
.work/bun-cache/
.work/tmp/

# Capture output. The harnesses under .work/stocktake are tracked; the
# screenshots they produce are evidence, not repository content.
.work/stocktake/**/*.png

# Recorded preview takes and their run logs — outputs, not source
.work/preview/
.work/testrun.log

# Submission bundle. The written submission documents stay tracked; the
# exported IPAs, screenshot sets, evidence archives and the preview video
# are deliverables for the handoff, not repository content. The curated
# in-repo evidence lives in demo-captures/.
submission/build/
submission/screens/
submission/video/
submission/*.zip

# MCP result cache written by the local tool bridge.
.manus/
